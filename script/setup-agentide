#!/bin/bash
# Configure AgentIDE remote access for a Sandvault account

set -eo pipefail

SANDVAULT_USER="${1:?Sandvault user required}"
SANDVAULT_SHARED_WORKSPACE="${2:?Sandvault shared workspace required}"

cd "$(dirname "$0")/.." || exit
DOTFILESDIR="$(pwd -P)"

AGENTIDE_TMPDIR="$(mktemp -d)"
trap 'rm -rf "${AGENTIDE_TMPDIR}"' EXIT

# Render the account-specific values before comparing with the system file.
SSHD_CONFIG_SOURCE="${DOTFILESDIR}/etc/ssh/sshd_config.d/000-agentide.conf.in"
SSHD_CONFIG="/etc/ssh/sshd_config.d/000-agentide.conf"
sed \
  -e "s|@SANDVAULT_USER@|${SANDVAULT_USER}|g" \
  -e "s|@SANDVAULT_SHARED_WORKSPACE@|${SANDVAULT_SHARED_WORKSPACE}|g" \
  "${SSHD_CONFIG_SOURCE}" \
  > "${AGENTIDE_TMPDIR}/000-agentide.conf"
if ! cmp -s "${AGENTIDE_TMPDIR}/000-agentide.conf" "${SSHD_CONFIG}"; then
  sudo /usr/bin/install -m 644 "${AGENTIDE_TMPDIR}/000-agentide.conf" \
    "${SSHD_CONFIG}"
  printf '%s -> %s\n' "${SSHD_CONFIG_SOURCE}" "${SSHD_CONFIG}"
fi

# Let Sandvault generate authorized_keys from its host-owned key directory.
AUTHORIZED_KEY_SOURCES=(
  "${DOTFILESDIR}/ssh/id_ed25519.pub"
  "${DOTFILESDIR}/etc/ssh/authorized_keys.d/agentide"
)
SANDVAULT_AUTHORIZED_KEYS_DIR="${HOME}/.config/codeofhonor/sandvault/authorized_keys.d"
/usr/bin/install -d -m 700 "${SANDVAULT_AUTHORIZED_KEYS_DIR}"
for AUTHORIZED_KEY_SOURCE in "${AUTHORIZED_KEY_SOURCES[@]}"; do
  SANDVAULT_AUTHORIZED_KEY="${SANDVAULT_AUTHORIZED_KEYS_DIR}/${AUTHORIZED_KEY_SOURCE##*/}"
  if ! cmp -s "${AUTHORIZED_KEY_SOURCE}" "${SANDVAULT_AUTHORIZED_KEY}"; then
    /usr/bin/install -m 600 "${AUTHORIZED_KEY_SOURCE}" \
      "${SANDVAULT_AUTHORIZED_KEY}"
    printf '%s -> %s\n' "${AUTHORIZED_KEY_SOURCE}" "${SANDVAULT_AUTHORIZED_KEY}"
  fi
done

# Keep the Sharing pane's SSH allow-list aligned with the generated config.
if ! /usr/sbin/dseditgroup -o checkmember -m "${SANDVAULT_USER}" \
  com.apple.access_ssh &>/dev/null; then
  sudo /usr/sbin/dseditgroup -o edit -a "${SANDVAULT_USER}" -t user \
    com.apple.access_ssh
fi

# Enable SSH last, after its restrictions and authorised key are in place.
if ! /bin/launchctl print-disabled system |
  grep '"com.openssh.sshd" => enabled' &>/dev/null; then
  sudo /usr/sbin/systemsetup -setremotelogin on
fi
